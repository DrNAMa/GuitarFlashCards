+"""
+KeepTrack
+=========
+
+Manages score tracking and accuracy calculation for the flash card game.
+
+This module maintains a record of all user answers (correct/incorrect) and
+calculates the accuracy percentage for display.
+
+Public API
+----------
+
+- :py:func:~GuitarFlashCards.KeepTrack.KeepTrack
+- :py:func:~GuitarFlashCards.KeepTrack.PullTrack
+- :py:func:~GuitarFlashCards.KeepTrack.ClearTrack
+
+"""

Public Class KeepTrack

"""Static class for tracking answer correctness and calculating accuracy."""
Private Shared l As New List(Of Boolean)

Public Shared Sub KeepTrack(b As Boolean)

   """Records a single answer result.

   :param b: True if answer was correct, False if incorrect

   :type b: Boolean

   """
   l.Add(b)

End Sub
Public Shared Function PullTrack() As String

   """Calculates and returns the current accuracy percentage.

   Computes the percentage of correct answers and formats it as a string

   with two decimal places.

   :return: Accuracy percentage string (e.g., "85.50%")

   :rtype: String

   """
   Dim a As Integer = l.Count
   Dim b As Integer = l.Where(Function(item) item = True).Count
   Dim c As Double = (b / a) * 100
   Dim d As String = Format(c, "0.00").ToString() & "%"
   Return d

End Sub
Public Shared Sub ClearTrack()

   """Clears all tracked answer records and resets the score."""
   l.Clear()

